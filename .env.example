# Required for real-LLM runs.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Required PostgreSQL connection for normal development.
DATABASE_URL=postgresql://postgres:replace_with_password@localhost:5432/northstar

# Optional isolated smoke-test database. Required when NORTHSTAR_SMOKE_TEST_MODE=1.
SMOKE_TEST_DATABASE_URL=postgresql://postgres:replace_with_password@localhost:5432/northstar_smoke

# Safe default. Set to gmail only for controlled Gmail OAuth testing.
COMMUNICATION_BACKEND=mock

# Optional Gmail OAuth paths; never commit the referenced files.
NORTHSTAR_GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
NORTHSTAR_GMAIL_TOKEN_PATH=credentials/gmail_token.json
NORTHSTAR_GMAIL_TEST_RECIPIENT=
NORTHSTAR_GMAIL_INTEGRATION_TESTS=0

# Optional diagnostics and test controls.
NORTHSTAR_BUSINESS_CHECKS=1
NORTHSTAR_DIAGNOSTICS=0
NORTHSTAR_SMOKE_TEST_MODE=0
NORTHSTAR_SMOKE_TEST_READ_ONLY=0
NORTHSTAR_TRANSIENT_FAILURES=
NORTHSTAR_TRANSIENT_FAILURE_STATE_FILE=
